+        external_messages.enqueue(cur_mesg);
+    }
+    // If nothing was deliverable, don't burn a core cycling the requeued messages.
+    if (!delivered_any && !requeued_messages.empty()) {
+        ultramodern::sleep_milliseconds(1);
+    }
+}
