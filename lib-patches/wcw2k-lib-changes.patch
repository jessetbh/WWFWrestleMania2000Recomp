+    GBIManager::GBIManager() {
+        GBI_EXTENDED::initialize();
+
+        if (!textAndDataSegmentsSorted) {
+            std::sort(textSegments.begin(), textSegments.end());
+            std::sort(dataSegments.begin(), dataSegments.end());
+            textAndDataSegmentsSorted = true;
+        }
+    }
