+    static int64_t last_ms = 0;
+    int64_t now = std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    if (last_ms == 0) { last_ms = now; return; }
+    if (now - last_ms < 1000) { return; }
+    last_ms = now;
